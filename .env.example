# Copy to backend/.env for local development.
# Local dev uses your `az login` identity (DefaultAzureCredential), so no API key is needed.
AZURE_OPENAI_ENDPOINT=https://<foundry-name>.openai.azure.com/
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-name>.services.ai.azure.com/api/projects/etm-project
MAIN_MODEL_DEPLOYMENT=gpt-5-mini
MINI_MODEL_DEPLOYMENT=gpt-4.1-mini
ALLOWED_ORIGINS=http://localhost:5173
